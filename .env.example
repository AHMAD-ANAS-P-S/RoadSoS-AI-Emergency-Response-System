# RoadSoS Environment Variables
# Copy this file to .env and fill in your values

# ─── FRONTEND ────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─── AI APIs (optional — keyword fallback works without these) ─
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ─── SMS ALERTS (Twilio) ─────────────────────────────────────
# Get free trial at twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ─── TELEGRAM BOT ────────────────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_CHAT_ID=your_chat_id

# ─── BACKEND ─────────────────────────────────────────────────
SECRET_KEY=roadsos-change-this-in-production-please
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,https://roadsos.vercel.app
DEBUG=false
